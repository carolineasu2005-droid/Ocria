/config/.ai_provider.*.tmp

# Editors and operating systems
.idea/
.vscode/
.DS_Store

# Local project documentation
*.md
# BossOCR project retrospective rules and generated review documents
!docs/project-review/*.md
!docs/project-review/**/*.md
# Historical BossOCR Issue-Next TIDs
!docs/tid/
!docs/tid/next/
